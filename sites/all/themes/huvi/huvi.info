name = huvi
description = Please provide a description for your theme.
base theme = omega
screenshot = screenshot.png
engine = phptemplate
core = 7.x

; ========================================
; Stylesheets
; ========================================
stylesheets[all][] = css/huvi.normalize.css
stylesheets[all][] = css/huvi.hacks.css
stylesheets[all][] = css/huvi.styles.css
stylesheets[all][] = css/huvi.no-query.css
stylesheets[all][] = css/jquery-ui-1.9.2.custom.css

; ========================================
; Scripts
; ========================================
scripts[] = js/jquery-ui-1.9.2.custom.js
scripts[] = js/huvi.behaviors.js
scripts[] = js/main.js

; ========================================
; Regions
; ========================================
regions[top_bar_left] = Top bar left
