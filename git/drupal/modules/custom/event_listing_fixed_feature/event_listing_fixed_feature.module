<?php

/**
 * @file
 * Code for the clone_of_event_listing_feature feature.
 */

include_once 'event_listing_fixed_feature.features.inc';

function huvi_views_pre_render(&$view) { // Change Toimumiskoht - Asukoht fields.
  // Scramble the order of the rows shown on this result page.
  // Note that this could be done earlier, but not later in the view execution
  // process.
  if ($view->name == 'event_listing_fixed') {
    $count = count($view->result);
    if(empty($view->result) or $count == 0){
      return;
    }
    for ($i = 0; $i < $count; $i++) {
      $toimumiskoht = NULL;
      $place_to_print = Null;
      $place = Null;

      if(!empty($view->result[$i]->field_field_schedule_toimumis[0])){
        $toimumiskoht = $view->result[$i]->field_field_schedule_toimumis[0]['rendered']['#markup'];
      }
      if(!empty($view->result[$i]->field_field_schedule_place)){
        $place = $view->result[$i]->field_field_schedule_place[0]['rendered']['#markup'];
      }
      if (isset($toimumiskoht)){
        $place_to_print .= $toimumiskoht;
      }
      if (!empty($place)) {
        $place =  preg_replace('/, ?(Eesti|Estonia)$/', '', $place);
        $place =  preg_replace('/, ?\d* ?Tallinn$/', '', $place);
        if (!empty($place_to_print) && !empty($place))
          $place_to_print .=  ', ';
        $place_to_print .= $place;
      }

      $view->result[$i]->field_field_schedule_place[0]['rendered']['#markup'] = $place_to_print;
      $view->result[$i]->field_field_schedule_toimumiskoht[0]['rendered']['#markup'] = "";
    }
  }
  return $view;
}

/**
 *
 * Implements hook_form_alter().
 */
function event_listing_fixed_feature_form_alter(&$form, &$form_state, $form_id) {

  if($form_id == 'views_exposed_form') {
    $activites_displays = array('views-exposed-form-event-listing-fixed-block-6',
      'views-exposed-form-event-listing-fixed-block-7',
      'views-exposed-form-event-listing-fixed-block-8',
      'views-exposed-form-event-listing-fixed-block-9',
      'views-exposed-form-event-listing-fixed-block-10',
      'views-exposed-form-event-listing-fixed-block-13',
      );
    if(in_array( $form['#id'], $activites_displays)){
      $options = $form['field_categories_activity_value_i18n']['#options'];
      $options = array_slice($options, 0, 6);
      $form['field_categories_activity_value_i18n']['#size'] = count($options);
      $form['field_categories_activity_value_i18n']['#options'] = $options;
            
      $options_muu = $form['field_categories_activity_value_i18n_muu']['#options'];
      $options_muu = array_slice($options_muu, 6);
      $form['field_categories_activity_value_i18n']['#size'] = count($options);
      $form['field_categories_activity_value_i18n_muu']['#options'] = $options_muu;
    }
  }
}