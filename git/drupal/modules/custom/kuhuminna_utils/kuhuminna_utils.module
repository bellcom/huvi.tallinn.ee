/**
 * Disable manual user registering
 * (only allow registering and logging with ID card via OpenID)
 *
 * Implements hook_form_alter().
 */
function kuhuminna_utils_form_alter(&$form, &$form_state, $form_id) {
  global $user;
  if(!in_array('administrator', $user->roles)
    && !in_array('manager', $user->roles)) {
    switch($form_id) {
      //case 'user_login':
      case 'user_register_form':
      //case 'user_profile_form':
      case 'openid_user_add';
      //case 'openid_ee_login_form';
        $form['#access'] = FALSE;
      break;
    }
  }
  if($form_id == 'views_exposed_form') {
    if($_SERVER['REQUEST_URI'] == 'uritused') {
      $form['#action'] = url('uritused');
      $form['#action'] = '/uritused';
      $form['action'] = '/uritused';
    }
    else if($_SERVER['REQUEST_URI'] == 'huvitegevused') {
      $form['#action'] = url('huvitegevused');
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function kuhuminna_utils_form_user_login_alter(&$form, &$form_state) {
  //dpm($form);
  //$form['openid_ee'] = drupal_get_form('openid_ee_login_form');
  $form['openid_idcard'] = array(
    '#type' => 'markup',
    '#markup' => '<a id="id-card-button" class="id-button" href="/mobileid?action=eid-login">'
        . t('ID-Card') .
      '</a>',
  );
  if(module_exists('kuhuminna_mobile_id')) {
    $form['openid_mobile'] = array(
      '#type' => 'markup',
      '#markup' => '<a id="mobile-id-button" class="id-button" href="/mobileid?action=mid-login">'
          . t('MobileID') .
        '</a>',
    );
  }

}


/**
 * Detect current section. Event or activity.
 *
 * @return string
 *   section name
 */
function kuhuminna_utils_get_section() {

  //$arguments = arg();
  // arg() replaced with request_uri to work with node url aliases
  $arguments = explode('/', request_uri());
  if (isset($arguments[1]) && $arguments[1] == 'huvitegevused') {
    return 'activities';
  }

  if (isset($arguments[1]) && $arguments[1] == 'huvitegevus') {
    return 'activities';
  }

  return 'events';
}


/**
 * Section switcher bottom block content.
 *
 * @return string
 *   html content
 */
function kuhuminna_utils_switcher_bottom_content() {

  $classes = array();

  // Get current section. Events or activities.
  $current_section = kuhuminna_utils_get_section();

  // Switch text depending on section.
  if ($current_section == 'activities') {
    $text = 'Vaata kindlasti ka üritusi!';
    $url = 'uritused';
    $class = 'goto-events';
  }
  else {
    $text = 'Vaata kindlasti ka huvitegevusi!';
    $url = 'huvitegevused';
    $class = 'goto-activities';
  }

  $content = '<div class="section-switcher-bottom">';
  $options = array(
    'attributes' => array(
      'class' => array($class),
    ),
    'html' => TRUE,
  );
  $link = l('<span>' . $text . '</span>', $url, $options);
  $content .= $link;
  $content .= '</div>';

  return $content;
}


/**
 * Alter metatags before being cached.
 *
 * This hook is invoked prior to the meta tags for a given page are cached.
 *
 * @param array $output
 *   All of the meta tags to be output for this page in their raw format. This
 *   is a heavily nested array.
 * @param string $instance
 *   An identifier for the current page's page type, typically a combination
 *   of the entity name and bundle name, e.g. "node:story".
 * @param array $options
 *   All of the options used to generate the meta tags.
 */
function kuhuminna_utils_metatag_metatags_view_alter(&$output, $instance, $options) {

  $path = current_path();
  if(drupal_match_path($path, 'uritus/*') || drupal_match_path($path, 'huvitegevus/*')) {
    if (isset($output['description']['#attached']['drupal_add_html_head'][0][0]['#value'])) {

      $event_data = kultuurikava_get_event_data(arg(1));
      if(isset($event_data) && !empty($event_data)) {

        if(isset($event_data['excerpt']) && !empty($event_data['excerpt'])) {
          $output['description']['#attached']['drupal_add_html_head'][0][0]['#value'] = trim(preg_replace('/\s+/', ' ', $event_data['excerpt']));
        }
      }

    }

  }
}

function kuhuminna_utils_get_tallinn_weather() {

	$url = 'http://ilm.ee/~data/tallinn_online_json.php3';
	$results = drupal_http_request($url, array('method' => 'GET'));

	if ($results->code == 200) {
		$json_decode = drupal_json_decode($results->data);

		if(isset($json_decode['tallinn']) && !empty($json_decode['tallinn'])) {
			$tallinn_info = $json_decode['tallinn'];
			return $tallinn_info;
		}
	}

	return;
}

function kuhuminna_utils_date_content() {
	$dayOfWeek = format_date(time(), 'custom', 'l');
	$date = format_date(time(), 'custom', 'd.m.Y');
	$content = '<strong>' . $dayOfWeek . ' </strong>' . $date;
	return $content;
}


function kuhuminna_utils_weather_content() {

	$content = '<div class="weather">';

	$weather_info = kuhuminna_utils_get_tallinn_weather();

	$temp = '';

	if($weather_info) {

		// Get weather icon
		if(isset($weather_info['pilv']) && !empty($weather_info['pilv'])) {
			$icon = kuhuminna_utils_weather_icon($weather_info['pilv']);
			//$icon = kuhuminna_utils_weather_icon('4cloud_lighthail');


			$icon_path = drupal_get_path('theme', 'huvi') . '/images/weather/' . $icon;
			$icon_class = str_replace('.png', '', $icon);

			//$content .= '<span class="weather-icon ' . $icon_class . '"></span>';
			$content .= '<span class="weather-icon"><img src="/' . $icon_path . '" /></span>';
		}


		if($weather_info['temp'] > 0) {
			$temp .= '+';
		}
		$temp .= $weather_info['temp'] . ' °C';
		$content .= $temp;
	}

	$content .= '</div>';
	return $content;
}


