/**
 * Implements hook_node_presave
 * Since the Geolocation module doesn't save the textual address,
 * we have to get it and save it as a separate field.
 */
function kuhuminna_utils_node_presave($node) {
  if($node->type == 'event') {
    if(isset($node->field_schedule)) {
      foreach($node->field_schedule['und'] as $key => $value) {
        if(isset($node->field_schedule['und'][$key]['field_schedule_location']['und'][0]['address']['field'])) {
          $node->field_schedule['und'][$key]['field_schedule_place']['und'][0]['value'] = $node->field_schedule['und'][$key]['field_schedule_location']['und'][0]['address']['field'];
          $node->field_schedule['und'][$key]['entity']->field_schedule_place['und'][0]['value'] = $node->field_schedule['und'][$key]['field_schedule_location']['und'][0]['address']['field'];
        }
      }
    }
    $node->status = '1';
    if(isset($node->field_unpublish['und'][0]['value'])) {
      if($node->field_unpublish['und'][0]['value'] == 1) {
        $node->status = '0';
      }
    }
  }
}


/**
 * Implements hook_utils_preprocess_page
 * Adds drupal admin theme style for event adding and editing page
 */
function kuhuminna_utils_preprocess_page(&$vars, $hook) {
  if ((arg(0) == 'node')
    && (arg(1) == 'add' && arg(2) == 'event')
    || arg(2) == 'edit') {
    drupal_add_css('themes/seven/style.css');
  }
}


/**
 * Implements hook_preprocess_html
 */
function kuhuminna_utils_preprocess_html(&$variables) {
  $headers = drupal_get_http_header();
  if (isset($headers['status']) && $headers['status'] == '404 Not Found') {
    $variables['classes_array'][] = 'page-404';
  }
  if (isset($headers['status']) && $headers['status'] == '403 Forbidden') {
    $variables['classes_array'][] = 'page-403';
  }
}


/**
 * Makes URL in texsts active html links
 */
function kuhuminna_utils_linkify($value, $protocols = array('http', 'mail'), array $attributes = array()) {
    // Link attributes
    $attr = '';
    foreach ($attributes as $key => $val) {
        $attr = ' ' . $key . '="' . htmlentities($val) . '"';
    }

    $links = array();

    // Extract existing links and tags
    $value = preg_replace_callback('~(<a .*?>.*?</a>|<.*?>)~i', function ($match) use (&$links) { return '<' . array_push($links, $match[1]) . '>'; }, $value);

    // Extract text links for each protocol
    foreach ((array)$protocols as $protocol) {
        switch ($protocol) {
            case 'http':
            case 'https':   $value = preg_replace_callback('~(?:(https?)://([^\s<]+)|(www\.[^\s<]+?\.[^\s<]+))(?<![\.,:])~i', function ($match) use ($protocol, &$links, $attr) { if ($match[1]) $protocol = $match[1]; $link = $match[2] ?: $match[3]; return '<' . array_push($links, "<a $attr href=\"$protocol://$link\">$link</a>") . '>'; }, $value); break;
            case 'mail':    $value = preg_replace_callback('~([^\s<]+?@[^\s<]+?\.[^\s<]+)(?<![\.,:])~', function ($match) use (&$links, $attr) { return '<' . array_push($links, "<a $attr href=\"mailto:{$match[1]}\">{$match[1]}</a>") . '>'; }, $value); break;
            case 'twitter': $value = preg_replace_callback('~(?<!\w)[@#](\w++)~', function ($match) use (&$links, $attr) { return '<' . array_push($links, "<a $attr href=\"https://twitter.com/" . ($match[0][0] == '@' ? '' : 'search/%23') . $match[1]  . "\">{$match[0]}</a>") . '>'; }, $value); break;
            default:        $value = preg_replace_callback('~' . preg_quote($protocol, '~') . '://([^\s<]+?)(?<![\.,:])~i', function ($match) use ($protocol, &$links, $attr) { return '<' . array_push($links, "<a $attr href=\"$protocol://{$match[1]}\">{$match[1]}</a>") . '>'; }, $value); break;
        }
    }

    // Insert all link
    return preg_replace_callback('/<(\d+)>/', function ($match) use (&$links) { return $links[$match[1] - 1]; }, $value);
}


