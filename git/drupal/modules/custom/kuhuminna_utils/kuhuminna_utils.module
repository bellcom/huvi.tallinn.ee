/**
 * Implements hook_menu().
 */
function kuhuminna_utils_menu() {
  $items = array();

  $items["landing"] = array(
    'page callback' => 'kuhuminna_utils_landing',
    'access callback' => TRUE,
    'type' => MENU_NORMAL_ITEM,
  );

  return $items;
}


/**
 * Implements hook_block_info().
 */
function kuhuminna_utils_block_info() {
  $blocks['kuhuminna_utils_switcher_bottom'] = array(
    'info' => t('Section switcher bottom'),
  );
  $blocks['kuhuminna_utils_switcher_top'] = array(
    'info' => t('Section switcher top'),
  );

  $blocks['kuhuminna_utils_weather'] = array(
    'info' => t('Weather'),
  );

  $blocks['kuhuminna_utils_date'] = array(
    'info' => t('Date'),
  );

  return $blocks;
}


/**
 * Implements hook_block_view().
 *
 * This hook generates the contents of the blocks themselves.
 */
function kuhuminna_utils_block_view($delta = '') {
  $block = array();

  // The $delta parameter tells us which block is being requested.
  switch ($delta) {
    case 'kuhuminna_utils_switcher_bottom':
      $block['subject'] = t('Section switcher bottom');
      $block['content'] = kuhuminna_utils_switcher_bottom_content();
      break;
    case 'kuhuminna_utils_weather':
      $block['subject'] = t('Weather');
      $block['content'] = kuhuminna_utils_weather_content();
      break;
    case 'kuhuminna_utils_date':
      $block['subject'] = t('Date');
      $block['content'] = kuhuminna_utils_date_content();
      break;
  }
  return $block;
}


