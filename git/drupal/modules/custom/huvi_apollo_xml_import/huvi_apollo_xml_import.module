    1038 => 2944191, // Kesklinn - "Apollo Kino Solaris
    1046 => 2944190, // Lasnamäe - "Apollo Kino Ülemiste
    1051 => 2944191, // Kesklinn - "Apollo Kino Coca-Cola Plaza
    1044 => 2944189, // Kristiine - "Apollo Kino Kristiine
    1045 => 2244888, // Mujal Eestis - "Apollo Kino Eeden
    1042 => 2244888, // Mujal Eestis - "Apollo Kino Lõunakeskus
    1037 => 2244888, // Mujal Eestis - "Apollo Kino Pärnu
    1043 => 2244888, // Mujal Eestis - "Apollo Kino Saaremaa
    1041 => 2244888, // Mujal Eestis - "Apollo Kino Astri
    1049 => 2244888, // Mujal Eestis - "Apollo Kino Jõhvi
