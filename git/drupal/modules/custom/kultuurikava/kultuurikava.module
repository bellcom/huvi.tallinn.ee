/*
 * Helper function.
 * Return filters array based on catregories array
 *
 */
function _kultuurikava_mapping_event_categories_to_filters($categories){
  $filters =  array();
  $event_categories =array(
    'muusika' => array('ev_0', 'act_0'),
    'etendus' => array('ev_1'),
    'muuseum' => array('ev_2'),
    'laat' => array('ev_3'),
    'sport' => array('ev_4', 'act_3'),
    'kino' => array('ev_5'),
    'klub' => array('ev_6'),
    'lapsed' => array('ev_7', 'act_7'),
    'varia' => array('ev_8', 'act_8'),
    'kunst' => array( 'act_1'),
    'tants' => array('act_2'),
    'sport' => array('act_3'),
    'tehn' => array('act_4'),
    'keel' => array( 'act_5'),
    'kursused' => array('act_6'),
  );
   foreach($categories as $category){
     $filters = array_merge($filters, $event_categories[$category]);
   }
   return  $filters;
}
/*
 * Helper function.
 * Return categories array based on filters array
 *
 */
function _kultuurikava_mapping_filters_to_event_categories($filters) {
  $categories =  array();
  $filters_array =  array(
    'act_0' => 'muusika',
    'act_1' => 'kunst',
    'act_2' => 'tants',
    'act_3' => 'sport',
    'act_4' => 'tehn',
    'act_5' => 'keel',
    'act_6' => 'kursused',
    'act_7' => 'lapsed',
    'act_8' => 'varia',
    'ev_0' => 'muusika',
    'ev_1' => 'etendus',
    'ev_2' => 'muuseum',
    'ev_3' => 'laat',
    'ev_4' => 'sport',
    'ev_5' => 'kino',
    'ev_6' => 'klub',
    'ev_7' => 'lapsed',
    'ev_8' => 'varia',
  );
  foreach ((array) $filters as $filter) {
    $categories[] = $filters_array[$filter];
  }
  return $categories;
}

/*
 * Helper function. Return date filters.
 */

function _kultuurikava_get_relative_date_filters($timestamp){
  $existing_dates =  &drupal_static('kultuurikava_existing_dates');

  if ($timestamp < strtotime('tomorrow')) {
     $existing_dates[] = 'today';
  }
  if($timestamp > strtotime('tomorrow') && $timestamp < strtotime('tomorrow + 1 day')) {
     $existing_dates[] = 'tomorrow';
  }
  if($timestamp > strtotime('Friday this week') && $timestamp < strtotime('Monday next week')) {
     $existing_dates[] = 'fs';
  }
  if ($timestamp < strtotime('last day of this month')) {
     $existing_dates[] = 'month';
  }
}

function _kultuurikava_check_date_filters($timestamp, $filter, $start_date=null, $end_date=null){
  switch ($filter) {
    case 'all':
      return TRUE;
    case 'today' :
      $start_date = time();
      $end_date = strtotime('tomorrow');
      break;
    case 'tomorrow':
      $start_date = strtotime('tomorrow');
      $end_date = strtotime('tomorrow + 1 day');
      break;
    case 'fs' :
      $start_date = strtotime('Friday this week');
      $end_date = strtotime('Monday next week');
      break;
    case 'month' :
      $start_date = time();
      $end_date = strtotime('last day of this month');
      break;
  }
  if($timestamp > $start_date && $timestamp < $end_date) {
    return TRUE;
  }

  return FALSE;
}