/**
 * Get cities from city_id-s from kultuurikava
 *
 * @return array $return
 *   Ticket seller names for getting images
 */
function kultuurikava_city_from_id($city_id) {
  $cities = array(
    2944195 => 'pohja-tallinn',
    2944191 => 'kesklinn',
    2944198 => 'kesklinn', // vanalinn
    2944188 => 'kesklinn', // kadriorg
    2944187 => 'haabersti',
    2944189 => 'kristiine',
    2944190 => 'lasnamae',
    2944193 => 'mustamae',
    2920234 => 'pirita',
    2944194 => 'nomme',
  );
  if($city_id) {
    $city = $cities[$city_id];
    if($city) {
      return $city;
    }
    watchdog('kultuurikava', 'No city found with city_id: ' . $city_id, NULL, WATCHDOG_ERROR);
  }
  else {
    return $cities;
  }
}


/**
 * Get categories based on Kultuurikava category IDs
 *
 * @return array $return
 *   Category IDs to save to drupal
 */
function kultuurikava_event_categories_by_kk_ids($categories, $event_type) {
  /*
  0|Muusika
  1|Etendused
  2|Näitus, muuseum
  3|Mess, laat
  4|Sport
  5|Kino
  6|Pidu, klubid
  7|Lapsele
  8|Varia
  */
  $event = array(
    14453 => 0,
    369755 => 0,
    14452 => 1,
    14455 => 2,
    14465 => 2,
    14459 => 3,
    14456 => 4,
    14454 => 5,
    14457 => 6,
    160542 => 6,
    14458 => 7,
    5218297 => 8,
    5218295 => 8,
    14460 => 8,
    5218296 => 8,
    14463 => 8,
    14461 => 8,
    14462 => 8,
    14466 => 8,
    14464 => 8,
  );

  /*
  0|Muusika
  1|Kunst, käsitöö
  2|Tantsimine
  3|Sport, liikumine
  4|Tehnika
  5|Keeleõpe
  6|Koolitused, kursused
  7|Lapsele
  8|Varia
  */
  $activity = array(
    14453 => 0,
    5218295 => 1,
    369755 => 2,
    14456 => 3,
    5218296 => 4,
    5218297 => 5,
    160542 => 6,
    14458 => 7,
    14460 => 8,
    14452 => 8,
    14455 => 8,
    14465 => 8,
    14459 => 8,
    14454 => 8,
    14457 => 8,
    14463 => 8,
    14461 => 8,
    14462 => 8,
    14466 => 8,
    14464 => 8,
  );

  if($categories) {
    $list = $event;
    if($event_type == 'huvitegevus') {
      $list = $activity;
    }
    $return = array();
    foreach($categories as $key => $kk_id) {
      $return[] = $list[$kk_id];
    }
    return $return;
  }
  else {
    watchdog('kultuurikava', 'Category was empty to get event category listing', NULL, WATCHDOG_ERROR);
    return;
  }
}


/**
 * Save event from Kultuurikava as a node
 *
 * @param array $event_id
 *   Event ID of the Kultuurikava event
 */
function kultuurikava_event_data_node_save($event) {
  if(!$event) {
    watchdog('kultuurikava', "No event data found in function kultuurikava_event_data_node_save", NULL, WATCHDOG_ERROR);
    return;
  }
  $e = $event;

  // Check if the node exists already
  $query = new EntityFieldQuery();
  $result = $query->entityCondition('entity_type', 'node')
    ->entityCondition('bundle', 'event')
    ->fieldCondition('field_id', 'value', $e['id'], '=')
    ->execute();
  // Node exists, load the entity
  if($result) {
    foreach($result['node'] as $key => $val) {
      $entity_load = entity_load('node', array($key));
      foreach($entity_load as $ekey => $eval) {
        $entity = $eval;
      }
    }
  }
  // Node doesn't exist yet, create a new entity
  else {
    $values = array(
      'type' => 'event',
      'uid' => 1,
      'status' => 1,
      'comment' => 0,
      'promote' => 0,
      'language' => 'et',
    );
    $entity = entity_create('node', $values);
  }

  $w = entity_metadata_wrapper('node', $entity);
  $fields = kultuurikava_event_to_node_fields();
  foreach($fields as $event_item => $field) {
    if(isset($e[$event_item])) {
      switch($event_item) {
        case 'schedule':
          // Get and remove all the existing field collection items and save them again (because there might be changes)

          if(!empty($entity->field_schedule['und'])) {
            $s_values = array();
            foreach($entity->field_schedule['und'] as $s_key => $s_val) {
              $s_values[] = $s_val['value'];
              unset($entity->field_schedule['und'][$s_key]);
            }
            if(!empty($s_values)) {
              entity_delete_multiple('field_collection_item', $s_values);
            }
          }
          foreach($e['schedule'] as $key => $val) {
            $schedule_item = entity_create('field_collection_item', array('field_name' => 'field_schedule'));
            $schedule_item->setHostEntity('entity', $entity);
            $schedule_wrapper = entity_metadata_wrapper('field_collection_item', $schedule_item);

            if($val['start_time'] && is_int($val['start_time'])) {
              if(is_int($val['end_time']) && $val['end_time'] < 2000000000) {
                $schedule_wrapper->field_schedule_date[0]->set(array(
                  'value' => $val['start_time'],
                  'value2' => $val['end_time'],
                ));
              }
              else {
                $schedule_wrapper->field_schedule_date[0]->set(array(
                  'value' => $val['start_time'],
                ));
              }
            }
            if($val['city_id'] == '2944198' || $val['city_id'] == '2944188') {
              $val['city_id'] = 2944191;
            }
            $schedule_wrapper->field_schedule_place->set($val['place']);
            $schedule_wrapper->field_schedule_city_id->set($val['city_id']);
          }
          break;
        case 'ticketurl':
          $ticket_urls = array();
          foreach($e[$event_item] as $key => $val) {
            $ticket_urls[] = $val['ticketurl'];
          }
          if(!empty($ticket_urls)) {
            $w->{$field}->set($ticket_urls);
          }
          break;
        case 'categories':
          $field_name = 'field_categories_event';
          if($e['type'] == 'huvitegevus') {
            $field_name = 'field_categories_activity';
          }
          $categories = array();
          foreach($e[$event_item] as $category_id) {
            $categories = kultuurikava_event_categories_by_kk_ids($e[$event_item], $e['type']);
          }
          if(!empty($categories)) {
            $w->{$field_name}->set($categories);
          }
          break;
        case 'description':
          $w->{$field}->value->set($e[$event_item]);
          break;
        case 'type':
          $w->{$field}->set($e[$event_item]);
          break;
        default:
          $w->{$field}->set($e[$event_item]);
          break;
      }
    }
  }
  $w->field_source->set(3);
  $w->save();
}


/**
 * Convert node to proper event fields displayed on the event node template page
 *
 * @param object $node
 *   Event node to be converted to the event array
 *
 * @return array $e
 *   Event data for showing in the event template on the node page
 */
function kultuurikava_node_to_event($node) {
  $n = $node;
  $e = array();
  $addedMarkers = array();
  $fields = kultuurikava_event_to_node_fields();

  // If the event has sub-events set
 /* $sub_event_ids = kultuurikava_get_sub_event_ids($n->nid);
  if(isset($sub_event_ids)) {
    $sub_events = array();
    foreach($sub_event_ids as $sub_event_id) {
      $sub_event = kultuurikava_get_sub_event($sub_event_id);
      if(isset($sub_event) && is_array($sub_event)) {
        foreach ($sub_event as $s) {
          $sub_events[] = $s;
        }
      }
    }
    if(isset($sub_events)) {
      $sub_events = _kultuurikava_rearrange_sub_events($sub_events);
      //_kultuurikava_group_sub_events($sub_events);
      $e['sub_events'] = _kultuurikava_group_sub_events($sub_events);
    }
  }*/

  // If the event has a main event set
  if(isset($n->field_main_event_ref['und'][0]['node'])) {
    $main_node = $n->field_main_event_ref['und'][0]['node'];
    if($main_node->status == '1') {
      $e['main_event'] = array(
        'title' => $main_node->title,
        'path' => url('node/' . $main_node->nid),
      );
    }
  }

  foreach($fields as $event => $field) {
    switch($event) {
      case 'name':
        $e[$event] = $n->{$field};
        break;

		case 'korraldaja'://Korraldaja fields
		if(isset($n->{$field}['und'])) {
			foreach($n->{$field}['und'] as $key => $val) {
					if (isset($val['value'])) {
					$collections = entity_load('field_collection_item', array($val['value']));

						foreach($collections as $c) {
							if(isset($c->field_korraldaja_nimi['und'])) {
								foreach($c->field_korraldaja_nimi['und'] as $korraldaja_key => $nimi) {
									if(isset($nimi['value'])) {
									$korraldaja_nimi= $nimi['value'];
									$e[$event][$korraldaja_key]["name"] = $korraldaja_nimi;
									}
								}
							}
							if(isset($c->field_korraldaja_kontakttelefon['und'])) {
								foreach($c->field_korraldaja_kontakttelefon['und'] as $korraldaja_key => $kontakttelefon) {
									if(isset($kontakttelefon['value'])) {
									$korraldaja_kontakttelefon= $kontakttelefon['value'];
									$e[$event][$korraldaja_key]["phone"] = $korraldaja_kontakttelefon;
									}
								}
							}

							if(isset($c->field_korraldaja_e_post['und'])) {
								foreach($c->field_korraldaja_e_post['und'] as $korraldaja_key => $e_post) {
									if(isset($e_post['email'])) {
									$korraldaja_e_post= $e_post['email'];
									$e[$event][$korraldaja_key]["email"] = $korraldaja_e_post;
									}
								}
							}

						}


					}
			}
		}
        break;

      case 'schedule':
        if(isset($n->{$field}['und'])) {
          $event_key = 0;

          foreach($n->{$field}['und'] as $key => $val) {
           if (isset($val['value'])) {

            $collections = entity_load('field_collection_item', array($val['value']));

            foreach($collections as $c) {

              if(isset($c->field_schedule_date['und'])) {
                foreach($c->field_schedule_date['und'] as $time_key => $time) {

                  if(isset($time['value'])) {
                    if ($time['value'] < time()) continue;
                    $start_date = $time['value'];
                    $end_date = (isset($time['value2'])) ? $time['value2'] : '';
                    $e[$event][$event_key]['asort'] = $start_date;
                    $e[$event][$event_key]['time'] = kultuurikava_date_format_2($start_date, $end_date);
                    if(!empty($c->field_schedule_toimumis)){
                      $toimumiskoht = $c->field_schedule_toimumis['und'][0]['taxonomy_term']->name;
                    }
                    if(!empty($c->field_schedule_place)){
                      $place = $c->field_schedule_place['und'][0]['value'];
                    }
                    if(!empty($toimumiskoht)){
                      $e[$event][$event_key]['place'] = $toimumiskoht;
                      if(!empty($place))
                       $e[$event][$event_key]['place'] = ' <span class="event-place-toimumiskoht">'.$toimumiskoht .'</span><br>'. $place;
                    }
                    else{
                      $e[$event][$event_key]['place'] = isset($place) ? $place : '';
                    }

                    $event_key++;
                  }
                }
              }

              // Read manually inserted markers only when no imported ones were detected
              if(isset($c->field_schedule_location['und'][0]['lat']) && isset($c->field_schedule_location['und'][0]['lng'])) {
                $marker = $c->field_schedule_location['und'][0]['lat'] . ',' . $c->field_schedule_location['und'][0]['lng'];
                if(!isset($e['map_latlng'])) {
                  $addedMarkers['map_latlng'] = $marker;
                }
                if(isset($addedMarkers['map_markers'])) {
                  $addedMarkers['map_markers'] .= ';' . $marker;
                }
                else {
                  $addedMarkers['map_markers'] = $marker;
                }
              }
            }
          }
         }
        }
        break;
      case 'ticketurl':
        if(isset($n->{$field}['und'])) {
          foreach($n->{$field}['und'] as $key => $url) {
            $url_parse = parse_url($url['value']);
            if(!isset($url_parse['host'])) {
              $url_parse = explode('/', $url_parse['path']);
              $url_host = $url_parse[0];
              $url['value'] = 'http://' . $url['value'];

            }
            else {
              $url_host = $url_parse['host'];
            }
            if (substr($url_host, 0, strlen('www.')) == 'www.') {
              $url_host = substr($url_host, strlen('www.'));
            }
            $link_content = $url_host;
            $logo_filename = kultuurikava_get_ticket_seller_image($url_host);
            if(!empty($logo_filename)) {
			  $base_path = $GLOBALS['base_path'];
              $logo_url = drupal_get_path('theme', 'huvi') . '/images/ticketproviders/img/' . $logo_filename;
              if(file_exists($logo_url)) {
                $link_content = '<img src="' . $base_path . $logo_url . '" alt="' . $url_host . '" />';
              }
            }
            $t_link = l($link_content, $url['value'], array('attributes' => array('target' => '_blank'), 'html' => TRUE));
            $e[$event][$key] = $t_link;
          }
        }
        break;
      default:
        if(isset($n->{$field}['und'])) {
          if(isset($n->{$field}['und'][0]['value'])) {
            $e[$event] = $n->{$field}['und'][0]['value'];
          }
        }
        break;
    }
  }
  // If no markers are imported (most probably event was added manually),
  // then add the manually added markers if they exist
  if(!isset($e['map_markers']) && isset($addedMarkers['map_markers'])) {
    $e['map_markers'] = $addedMarkers['map_markers'];
    $e['map_latlng'] = $addedMarkers['map_latlng'];
  }

  return $e;
}


/**
 * Get sub events by node ID
 *
 * @param object $node_id
 *   Event node ID of which to get sub events from
 *
 * @return array $sub_events
 *   Sub events data
 */
function kultuurikava_get_sub_event_ids($node_id) {
  // Get parent term id.
  $query = db_select('field_data_field_main_event_ref', 'f');
  $query->fields('f', array('entity_id'));
  $query->condition('f.field_main_event_ref_nid', $node_id);
  $results = $query->execute()->fetchAll();
  $sub_event_ids = array();
  if($results) {
    foreach($results as $result) {
      $sub_event_ids[] = $result->entity_id;
    }
    return $sub_event_ids;
  }
  return;
}


/**
 * Get sub events by node ID
 *
 * @param object $node_id
 *   Event node ID of which to get the sub event data
 *
 * @return array $sub_events
 *   Data usable for event node view
 */
function kultuurikava_get_sub_event($node_id, $active_filters=array()) {
  // Get parent term id.
  $node = node_load($node_id);
  // Static variables for filters handler
   $existing_event_types =  &drupal_static('kultuurikava_existing_events_types');
   $existing_districts =  &drupal_static('kultuurikava_existing_districts');
   $existing_dates =  &drupal_static('kultuurikava_existing_dates');
   $current_event_types = array();
  // Use only published nodes
  if($node->status == '1') {
    $return = array();
    if(isset($node->field_schedule['und'])) {
      $event_type = field_get_items('node', $node, 'field_type');
      $event_type = reset($event_type);

      if ($event_type['value'] == 'uritus') {
        $event_category = field_get_items('node', $node, 'field_categories_event');
      }
      else{
        $event_category = field_get_items('node', $node, 'field_categories_activity');
      }

      foreach($node->field_schedule['und'] as $key => $val) {

        $tmp_data = array();

        if (isset($val['value'])) {

          $collections = entity_load('field_collection_item', array($val['value']));

          foreach($collections as $c) {

            if(isset($c->field_schedule_date['und'])) {
              foreach($c->field_schedule_date['und'] as $time_key => $time) {

                $tmp_time = '';
                if(isset($time['value'])) {
                  if ($time['value'] < time()) continue;
                  _kultuurikava_get_relative_date_filters($time['value']);
                  $start_date = $time['value'];
                  // Apply date filter
                  if (isset($active_filters['date']) && !empty($active_filters['date'])){
                    $period_start_date =  null;
                    $period_end_date = null;
                    if(($active_filters['date'][0]=='period') && isset($active_filters['period'])) {
                      $period_start_date = strtotime($active_filters['period']['start_date']);
                      $period_end_date = strtotime($active_filters['period']['end_date']);
                    }
                    if(_kultuurikava_check_date_filters($time['value'], $active_filters['date'][0], $period_start_date, $period_end_date) == FALSE) {
                      continue;
                    }
                  }
                  $end_date = (isset($time['value2'])) ? $time['value2'] : '';
                  $tmp_time = kultuurikava_date_format_2($start_date, $end_date, TRUE);
                  // Apply linnaosa filter
                  $existing_districts[] = $c->field_schedule_city_id['und'][0]['value'];
                  if (isset($active_filters['district'])
                      && !empty($active_filters['district'])
                      && !in_array($c->field_schedule_city_id['und'][0]['value'], $active_filters['district']) ) {
                    continue;
                  }
                  //// Apply tüüp filter
                  if (is_array($event_category)) {
                    foreach ($event_category as $value) {
                      $existing_event_types[] = ($event_type['value'] == 'uritus')? 'ev_' . $value['value'] : 'act_' . $value['value'];
                      $current_event_types[] = ($event_type['value'] == 'uritus')? 'ev_' . $value['value'] : 'act_' . $value['value'];
                    }
                  }
                  if(isset($active_filters['type']) && !empty($active_filters['type'])) {
                    if (array_intersect($active_filters['type'], $current_event_types) == array()) continue;
                  }
                  $toimumiskoht = '';
                  if (isset($c->field_schedule_toimumis['und'])) {
                    $toimumiskoht = taxonomy_term_load($c->field_schedule_toimumis['und'][0]['tid'])->name;
                  }
                  $place = $c->field_schedule_place['und'][0]['value'];
                  $tmp_place = '';
                  if(!empty($toimumiskoht)) {
                    $tmp_place = $toimumiskoht;
                  }
                  if(!empty($place)) {
                    $place =  preg_replace('/, ?(Eesti|Estonia)$/', '', $place);
                    $place =  preg_replace('/, ?\d* ?Tallinn$/', '', $place);
                    if (!empty($tmp_place) && !empty($place)){
                      $tmp_place .=  ', ' . $place;
                    }
                    else {
                      $tmp_place = $place;
                    }
                  }
                  $return[] = array(
                    'title' => $node->title,
                    'path' => url('node/' . $node->nid),
                    'timestamp' => $time['value'],
                    'time' => $tmp_time,
                    'place' => $tmp_place,
                  );
                }
              }
            }
          }
        }
      }
    }

    /*if (count($return) == 0) {
      $return[] = array(
        'title' => $node->title,
        'path' => url('node/' . $node->nid),
	'timestamp' => null,
        'time' => '',
        'place' => '',
      );
    }*/

    return $return;
  }
  return;
}


/**
 * Manually execute cron function for importing events from Kultuurikava API
 */
function kultuurikava_manual_import() {
  kultuurikava_cron();
  print t('Importing kultuurikava items...') . '<br>';
  print variable_get('kultuurikava_import_progress_text', 'updating status.') . '<br>';
  if(variable_get('kultuurikava_import_first_done') == TRUE) {
    print t('Refreshing automatically after every 3 minutes.') . '<br>';
    header("Refresh: 180;");
  }
  else {
    print t('Refreshing automatically after every 2 seconds.') . '<br>';
    header("Refresh: 2;");
  }
}


/* Helper functions */

/**
 * Function for date formating
 */
function kultuurikava_date_format ($start_date, $end_date) {
  $date_format = 'D, d.m.Y H:i';
  $short_date_format = 'D, d.m.Y';

  if(isset($end_date)) {
  // No need to show the ending date, when it's the same as the starting date
    if($start_date == $end_date) {
      if (date('H:i', $start_date) == '00:00')
       $date =  format_date($start_date, 'custom', $short_date_format) . ' ' . t('Kogu päev');
      else
        $date = format_date($start_date, 'custom', $date_format);
      }
    else {
      if (date('H:i', $start_date) == '00:00') {
        $date = format_date($start_date, 'custom', $short_date_format)
                . ' - '
                . format_date($end_date, 'custom', $short_date_format);
       }
       else {
         $date = format_date($start_date, 'custom', $date_format)
                . ' - '
                . format_date($end_date, 'custom', $date_format);
       }
      }
    }
    else {
      if (date('H:i', $start_date) == '00:00')
        $date =  format_date($start_date, 'custom', $short_date_format) . ' ' . t('Kogu päev');
      else
        $date =  format_date($start_date, 'custom', $date_format);
      }
  return $date;
}


/**
 * Another function for date formating
 */
function kultuurikava_date_format_2($start_date, $end_date = '', $only_time = FALSE) {
  $date_format = 'D, d.m.y';
  $date_format_time = 'H:i';

  if ($only_time) {
    $start_date_n_time =   format_date($start_date, 'custom', $date_format_time);
  }
  else {
    $start_date_formatted = format_date($start_date, 'custom', $date_format);
    $start_time_formatted = format_date($start_date, 'custom', $date_format_time);
    $start_date_n_time = t('!s_date kell !s_time', array(
    '!s_date' => $start_date_formatted,
    '!s_time' => $start_time_formatted,
   ));
  }


  $end_date_n_time = '';

  if ($end_date != '' && $start_date != $end_date) {
    if ($only_time) {
       $end_date_n_time = ' - ' . format_date($end_date, 'custom', $date_format_time);
    }
    else {
      $end_date_formatted = format_date($end_date, 'custom', $date_format);
      $end_time_formatted = format_date($end_date, 'custom', $date_format_time);
      $end_date_n_time = ' - ' . t('!s_date kell !s_time', array(
      '!s_date' => $end_date_formatted,
      '!s_time' => $end_time_formatted,
    ));
    }
  }

  return (date('H:i', $start_date) == '23:55')
    ? ($start_date_formatted . ' ' . t('Kogu päev'))
    : ($start_date_n_time . $end_date_n_time);
}



function _kultuurikava_rearrange_sub_events(&$arr) {
  $tmp_arr1 = array();
  $tmp_arr2 = array();

  foreach ($arr as $a) {
    if ($a['timestamp'] == null) $tmp_arr2[] = $a;
    else $tmp_arr1[] = $a;
  }

  usort($tmp_arr1, '_kultuurikava_sort_by_timestamp');
  $result = array_merge($tmp_arr1, $tmp_arr2);

  return $result;
}


function _kultuurikava_sort_by_timestamp($a, $b) {
  return $a['timestamp'] - $b['timestamp'];
}

function _kultuurikava_group_sub_events($arr) {
  $sub_events = array();
  foreach ($arr as $key => $sub_event) {
   $sub_events[date("Ymd", $sub_event["timestamp"])][] = $sub_event;
  }
  return $sub_events;
}

/**
 * Implements hook_block_info().
 */
function kultuurikava_block_info() {
  $blocks = array();
  $blocks['kultuurikava_sub_events_block'] = array(
    'info' => t('Subevents'),
  );

  return $blocks;
}

/**
 * Implements hook_block_view().
 */
function kultuurikava_block_view($delta='', $nid=null) {
  $block = array();
  switch($delta) {
    case 'kultuurikava_sub_events_block' :
      if (isset($nid)) {
        $filters = array();
        $active_filters = array('date' => array('all'));

        $node = node_load($nid);
        $show_filters = field_get_items('node', $node, 'field_subevents_filter');
         $existing_dates =  &drupal_static('kultuurikava_existing_dates');
         $existing_dates = array('all', 'period');
        if ($show_filters && $show_filters[0]['value'] == 1) {
          $event_type = field_get_items('node', $node, 'field_type');
          $event_type = reset($event_type);
          $filters = kultuurikava_get_filters($event_type['value']);
        }
        $sub_events = kultuurikava_get_subevents($nid, $active_filters);
        $existing_districts = &drupal_static('kultuurikava_existing_districts');
        $existing_event_types =  &drupal_static('kultuurikava_existing_events_types');
        if(is_array($existing_event_types)){
          $existing_event_types = array_unique($existing_event_types);
        }
        $existing_event_types = _kultuurikava_mapping_filters_to_event_categories($existing_event_types);
        if(is_array($existing_districts)){
          $existing_districts = array_unique($existing_districts);
        }
        $existing_dates = array_unique($existing_dates);
        if (count($existing_districts) == 1){
          unset($filters['district']);
        }
        if (count($existing_event_types ) == 1){
          unset($filters['type']);
        }
        $existing_filters = array ('district' => $existing_districts, 'type' => $existing_event_types , 'date' => $existing_dates);
        $block['content'] = theme('kultuurikava_subevents_block', array('parent_nid' => $nid,
          'subevents' => $sub_events,
          'filters' => $filters,
          'existing_filters' => $existing_filters,
          'active_filters'=> $active_filters)
        );
      }


      break;
  }

  return $block;
}
/*
 * Helper function
 * @return subevents for node
 */
function kultuurikava_get_subevents($nid, $active_filters = array()) {
  $sub_event_ids = kultuurikava_get_sub_event_ids($nid);
  if(isset($sub_event_ids)) {
    $sub_events = array();
    foreach($sub_event_ids as $sub_event_id) {
      $sub_event = kultuurikava_get_sub_event($sub_event_id, $active_filters);
      if(isset($sub_event) && is_array($sub_event)) {
        foreach ($sub_event as $s) {
          $sub_events[] = $s;
        }
      }
    }
    if(isset($sub_events)) {
      $sub_events = _kultuurikava_rearrange_sub_events($sub_events);
      $sub_events = _kultuurikava_group_sub_events($sub_events);

     return $sub_events;
    }
  }
}
